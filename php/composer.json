{
    "name": "apiverve/universitylookup",
    "description": "University Lookup is a university search and academic domain API covering about 12,000 institutions worldwide. Search by name and country, or pass a domain or email address to learn whether it belongs to a university, and for US institutions get IPEDS details such as control, level and highest degree, while paid plans add enrollment, admission rate and tuition.",
    "version": "1.2.6",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "universitylookup",
        "university lookup api",
        "university search api",
        "college api",
        "university domain api",
        "academic email check api"
    ],
    "homepage": "https://apiverve.com/marketplace/universitylookup?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/universitylookup",
        "source": "https://github.com/apiverve/universitylookup-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Universitylookup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Universitylookup\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
